{
  "name": "zephora-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST para automacao de salas Zephora",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
