{
  "name": "zephora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Zephora — automação de salas de aula com ESP32",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:seed": "node --env-file-if-exists=.env src/database/seed-owner.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "zod": "^3.25.76"
  }
}
