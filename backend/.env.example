# ── Ambiente ──────────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=3000

# ── Banco de Dados ───────────────────────────────────────────
# Local:  ./zephora.sqlite
# Azure:  /home/data/zephora.sqlite  (persistente entre deploys)
DATABASE_URL=./zephora.sqlite

# ── Autenticação JWT ─────────────────────────────────────────
# Em produção: mínimo 32 caracteres, único e aleatório.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ── Aplicação ────────────────────────────────────────────────
APP_NAME=Zephora
# Local:  http://localhost:3000
# Azure:  https://<seu-app>.azurewebsites.net
APP_URL=http://localhost:3000

# Local:  uploads
# Azure:  /home/uploads  (persistente entre deploys)
UPLOAD_DIR=uploads

# ── E-mail (SMTP) ───────────────────────────────────────────
# Deixe SMTP_HOST vazio para modo console (dev sem envio real).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zephora <no-reply@zephora.local>"

# ── Verificação de E-mail ───────────────────────────────────
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
MAX_VERIFICATION_ATTEMPTS=5

# ── Admin Inicial (seed) ────────────────────────────────────
# Em produção: altere para credenciais exclusivas.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@zephora.local
INITIAL_ADMIN_PASSWORD=Admin@123456
