NODE_ENV=development
PORT=3333
# URL pública da API (usada para montar links de fotos)
PUBLIC_URL=http://localhost:3333
# Nº de proxies reversos confiáveis à frente da API (0 = nenhum)
TRUST_PROXY=0

DB_PATH=./data/zephora.db
UPLOAD_DIR=./uploads

# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
CODE_HMAC_SECRET=
BCRYPT_COST=12

CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_RESEND_COOLDOWN_SECONDS=60
# Ex.: escola.edu.br,aluno.escola.edu.br (vazio = qualquer domínio)
ALLOWED_EMAIL_DOMAINS=

ESP32_OFFLINE_AFTER_SECONDS=60
ESP32_POLL_INTERVAL_MS=3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600

# SMTP (obrigatório em produção; sem SMTP os e-mails vão para o console em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zephora <no-reply@zephora.local>"

# Usados apenas por: npm run db:seed
OWNER_NAME=Administrador
OWNER_EMAIL=
OWNER_PASSWORD=
