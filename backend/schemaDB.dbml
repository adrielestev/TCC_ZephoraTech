Project room_automation {
  database_type: 'SQLite'
  Note: 'Modelo de referência DBML para o banco SQLite de automatização de salas.'
}

Table rooms {
  id integer [pk, increment]
  name text [not null]
  mac_address text [not null, unique, note: 'MAC obrigatório e único do controlador da sala']
  device_credential_hash text [unique, note: 'Hash da credencial do único controlador ESP32 da sala']
  last_seen_at text
  room_photo_1 text
  room_photo_2 text
  room_photo_3 text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'MAC obrigatório no formato AA:BB:CC:DD:EE:FF; API valida formato e SQLite trigger rejeita valor vazio. rooms.id identifica a sala internamente.'
}

Table users {
  id integer [pk, increment]
  name text [not null]
  email text [not null, unique]
  password_hash text [not null]
  is_email_verified integer [not null, default: 0, note: 'SQLite boolean: 0 ou 1']
  verification_code_hash text
  verification_expires_at text
  verification_attempts integer [not null, default: 0]
  last_code_sent_at text
  user_level text [not null, default: 'user', note: 'Papel global: admin ou user']
  user_photo text
  deleted_at text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'SQLite CHECKs: is_email_verified IN (0,1); verification_attempts >= 0; user_level IN (''admin'',''user''). E-mails são normalizados pela aplicação.'
}

Table password_reset_tokens {
  id integer [pk, increment]
  user_id integer [not null, unique]
  token_hash text [not null]
  expires_at text [not null]
  attempts integer [not null, default: 0]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    expires_at [name: 'idx_password_reset_expires']
  }

  Note: 'Armazena somente o hash do código temporário de recuperação; um código ativo por usuário.'
}

Table room_collaborators {
  id integer [pk, increment]
  room_id integer [not null]
  user_id integer [not null]
  added_by integer
  created_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (room_id, user_id) [unique, name: 'idx_room_collaborators_unique']
    user_id [name: 'idx_room_collaborators_user']
  }

  Note: 'Não há papel por sala; user_level define o papel global.'
}

Table sensors {
  id integer [pk, increment]
  room_id integer [not null]
  name text [not null, note: 'Nome amigável, por exemplo Luz principal']
  direction text [not null, note: 'SQLite CHECK: input ou output']
  type text [not null, note: 'SQLite CHECK: relay, pwm, temperature, presence, contact']
  pin integer [note: 'GPIO do controlador; NULL se não usar GPIO diretamente']
  config_json text [note: 'Configuração específica em JSON opcional']
  state_labels_json text [note: 'Mapa JSON de valores para rótulos, ex. {"0":"Desligado","1":"Ligado"}']
  value_unit text [note: 'Unidade opcional, ex. °C ou %']
  current_state real [note: 'Último valor reportado pelo hardware']
  desired_state real [note: 'Valor solicitado pelo sistema']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    room_id [name: 'idx_sensors_room']
    (room_id, pin) [unique, name: 'idx_sensors_room_pin']
  }

  Note: 'No SQLite, o índice único de GPIO deve ser parcial: WHERE pin IS NOT NULL. A tabela sensors representa todos os dispositivos.'
}

Table automation_rules {
  id integer [pk, increment]
  name text [not null]
  source_sensor_id integer [not null]
  operator text [not null, note: 'SQLite CHECK: eq, ne, gt, gte, lt, lte']
  comparison_value real [not null]
  target_sensor_id integer [not null]
  target_value real [not null]
  restore_previous integer [not null, default: 0, note: 'Quando ativo, restaura o valor anterior ao fim da condição e bloqueia comandos manuais enquanto a condição estiver ativa']
  is_active integer [not null, default: 0, note: 'Indica que esta regra está controlando temporariamente a saída']
  previous_target_value real [note: 'Valor salvo antes de a automação assumir o controle']
  is_enabled integer [not null, default: 1, note: 'SQLite boolean: 0 ou 1']
  cooldown_seconds integer [not null, default: 0]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    source_sensor_id [name: 'idx_automation_source']
    target_sensor_id [name: 'idx_automation_target']
  }

  Note: 'SQLite CHECKs: source_sensor_id <> target_sensor_id e is_enabled IN (0,1). Triggers validam origem input, destino output e mesma sala. Índice único parcial: target_sensor_id WHERE restore_previous = 1 AND is_active = 1 AND is_enabled = 1.'
}

Ref: room_collaborators.room_id > rooms.id [delete: cascade]
Ref: room_collaborators.user_id > users.id [delete: cascade]
Ref: room_collaborators.added_by > users.id [delete: set null]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: sensors.room_id > rooms.id [delete: cascade]
Ref: automation_rules.source_sensor_id > sensors.id [delete: cascade]
Ref: automation_rules.target_sensor_id > sensors.id [delete: cascade]
