{
  "expo": {
    "name": "zephora",
    "slug": "zephora",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-square.png",
    "scheme": "zephora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-square.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3FAFF",
          "image": "./assets/images/splash-zephora.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Zephora precisa acessar suas fotos para anexá-las ao perfil e às salas.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
