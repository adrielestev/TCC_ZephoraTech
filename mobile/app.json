{
  "expo": {
    "name": "Zephora",
    "slug": "zephora-app",
    "scheme": "zephora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zephora.app"
    },
    "android": {
      "package": "com.zephora.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1B3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Zephora",
      "shortName": "Zephora",
      "lang": "pt-BR",
      "themeColor": "#0B1B3F",
      "backgroundColor": "#F2F6FD"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1B3F"
        }
      ]
    ],
    "description": "Zephora — automação inteligente das salas de aula."
  }
}
